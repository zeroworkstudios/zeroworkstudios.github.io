---
// A blog post's comment thread, through Giscus (https://giscus.app).
// Each post's comments are a GitHub Discussion in this repo's Announcements category, matched by
// the post's slug, so renaming a post's title or moving its URL keeps its thread. Giscus opens the
// Discussion when the first comment comes in. Announcements is the category to use because only
// maintainers (and Giscus) can open Discussions there.
// The Giscus GitHub app must be installed on the repo: https://github.com/apps/giscus
// The widget is styled by public/giscus-theme.css. Giscus loads that file from inside its iframe on
// giscus.app, and browsers block a public site from loading files off localhost, so `npm run dev`
// on localhost uses the live site's copy too: changes to the theme show up locally once deployed.
// An https tunnel preview serves its own copy (vite.server.cors in astro.config.mjs lets giscus.app read it).
interface Props {
  /** The Discussion this post's comments live in: the post's slug. */
  term: string;
}
const { term } = Astro.props;

const themeHost = import.meta.env.PROD || Astro.url.protocol !== 'https:' ? Astro.site : Astro.url;
const theme = new URL('/giscus-theme.css', themeHost).href;
---

<section class="comments" id="comments" aria-label="Comments">
  <!-- Who the reader is signed in to Giscus as. Giscus never shows this itself, but with
       data-emit-metadata it posts the viewer to the page each time it loads the thread. -->
  <p class="comments__viewer" hidden>
    <img class="comments__avatar" alt="" width="22" height="22" />
    <span>Commenting as <a class="comments__login" rel="noopener"></a></span>
  </p>
  <div class="giscus"></div>
  <script
    is:inline
    src="https://giscus.app/client.js"
    data-repo="zeroworkstudios/zeroworkstudios.github.io"
    data-repo-id="R_kgDOV79Cug"
    data-category="Announcements"
    data-category-id="DIC_kwDOV79Cus4DMKw0"
    data-mapping="specific"
    data-term={term}
    data-strict="1"
    data-reactions-enabled="1"
    data-emit-metadata="1"
    data-input-position="top"
    data-theme={theme}
    data-lang="en"
    data-loading="lazy"
    crossorigin="anonymous"
    async></script>
  <script is:inline>
    (() => {
      const viewer = document.querySelector('.comments__viewer');
      const avatar = viewer.querySelector('.comments__avatar');
      const login = viewer.querySelector('.comments__login');

      // Signed out, Giscus reads the thread with its own app token and reports its bot as the
      // viewer. Its client keeps the reader's session in localStorage, so that tells the two apart.
      const signedIn = () => {
        try {
          return !!localStorage.getItem('giscus-session');
        } catch {
          return false;
        }
      };

      addEventListener('message', (e) => {
        if (e.origin !== 'https://giscus.app') return;
        const msg = e.data?.giscus;
        if (!msg || !('signOut' in msg || 'viewer' in msg)) return;
        const v = msg.viewer;
        if (msg.signOut || !signedIn() || !v?.login || v.login.endsWith('[bot]')) {
          viewer.hidden = true;
          return;
        }
        try {
          const src = new URL(v.avatarUrl);
          src.searchParams.set('s', '44');
          avatar.src = src.href;
        } catch {
          avatar.removeAttribute('src');
        }
        login.textContent = `@${v.login}`;
        login.href = v.url;
        viewer.hidden = false;
      });
    })();
  </script>
</section>
