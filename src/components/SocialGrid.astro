---
import BrandIcon from './BrandIcon.astro';

interface Social {
  id: string;
  name: string;
  url: string;
  handle: string;
}

interface Props {
  socials: Social[];
  heading: string;
  intro: string;
}

const { socials, heading, intro } = Astro.props;
---

<section id="channels" class="channels" aria-labelledby="channels-title">
  <div id="channel-links" class="sr-only"></div>
  <div class="sec-head">
    <h2 id="channels-title">{heading}</h2>
    <p>{intro}</p>
  </div>

  <ul class="dial" role="list">
    {
      socials.map((social) => (
        <li>
          <a class="chan" href={social.url} target="_blank" rel="noopener noreferrer">
            <span class="chan__icon">
              <BrandIcon id={social.id} class="chan__svg" />
            </span>
            <span class="chan__text">
              <span class="chan__name">{social.name}</span>
              <span class="chan__handle">{social.handle}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .dial {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 228px), 1fr));
    gap: 12px;
  }

  .chan {
    display: flex;
    align-items: center;
    gap: 14px;
    block-size: 100%;
    padding: 14px 16px 14px 14px;
    text-decoration: none;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 12px;
    transition:
      background-color 0.2s,
      border-color 0.2s,
      color 0.2s;
  }

  /* Channels behave like the studio's pill buttons: they fill with mahogany ink. */
  .chan:hover {
    background: var(--mahogany);
    border-color: var(--mahogany);
    color: var(--paper);
  }

  .chan__icon {
    inline-size: 42px;
    block-size: 42px;
    flex: none;
    display: grid;
    place-items: center;
    background: var(--desk);
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    transition: transform 0.4s var(--ease-spring), border-color 0.2s;
  }
  .chan:hover .chan__icon {
    border-color: var(--desk);
    transform: rotate(-6deg);
  }

  .chan__icon :global(.chan__svg) {
    inline-size: 22px;
    block-size: 22px;
  }

  .chan__text {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .chan__name {
    font: 700 17px/1.2 var(--font-display);
    letter-spacing: -0.02em;
  }

  /* Phones: two columns of upright tiles instead of eight long rows. */
  @media (max-width: 520px) {
    .dial {
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }
    .chan {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
      padding: 14px;
    }
  }

  .chan__handle {
    color: var(--muted);
    font-size: 13.5px;
    line-height: 1.4;
    overflow-wrap: anywhere;
    transition: color 0.2s;
  }
  .chan:hover .chan__handle {
    color: var(--line);
  }
</style>
