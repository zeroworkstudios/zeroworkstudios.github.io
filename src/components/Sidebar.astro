---
import '../styles/plates.css';
import PackagePlate from './PackagePlate.astro';
import GamePlate from './GamePlate.astro';
import { packages, href, home } from '../data/packages';
import { games, gameHref } from '../data/games';
import { posts, postHref, formatDate } from '../data/blog';

export type NavLink = { id: string; label: string };
export type NavGroup = NavLink & { children: NavLink[] };
export type SiteSection = 'about' | 'games' | 'docs' | 'blog';

interface Props {
  /** Which part of the site is open. */
  section: SiteSection;
  /** Slug of the game, package or post being shown, or undefined on that part's home. */
  current?: string;
  /** Docs: which page of that package is open. */
  page?: 'guide' | 'changelog';
  /** Docs: the guide's sections, H2 groups with their H3 children. */
  sections?: NavGroup[];
}

const { section, current, page, sections = [] } = Astro.props;
const here = (s: SiteSection) => section === s && !current;

/** The about page's sections. `platforms` is the studio section's long-standing anchor. */
const aboutLinks: NavLink[] = [
  { id: 'platforms', label: 'Studio' },
  { id: 'hank', label: 'Officer Hank' },
  { id: 'channels', label: 'Channels' },
];
---

<aside class="sidebar" id="sidebar" aria-label="Zero Work Studios">
  <div class="side-head">
    <a class="studio" href={home()}>
      <span class="studio__mark" aria-hidden="true">ZW</span>
      <span class="studio__name">Zero Work Studios</span>
    </a>
  </div>

  <div class="side-body">
  <nav class="side-group" aria-labelledby="side-about-title">
    <a class="side-title" id="side-about-title" href={home()} aria-current={section === 'about' ? 'page' : undefined}>
      About
    </a>
    <ul class="side-links" role="list">
      {
        aboutLinks.map((l) => (
          <li>
            {/* On the about page these drive the scroll spy; elsewhere they lead back to it. */}
            <a href={home(`#${l.id}`)} data-section={section === 'about' ? l.id : undefined}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <nav class="side-group" aria-labelledby="side-games-title">
    <a class="side-title" id="side-games-title" href={gameHref()} aria-current={here('games') ? 'page' : undefined}>
      Games
    </a>
    <ul class="pkgs" role="list">
      {
        games.map((game) => (
          <li class="pkg">
            <a
              class="pkg__card"
              href={gameHref(game.slug)}
              aria-current={section === 'games' && current === game.slug ? 'page' : undefined}
              title={game.status === 'soon' ? `${game.name} is in development` : undefined}
              style={`view-transition-name: plate-${game.slug}`}
            >
              <GamePlate game={game} />
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <nav class="side-group" aria-labelledby="side-pkgs-title">
    <a
      class="side-title"
      id="side-pkgs-title"
      href={href()}
      aria-current={here('docs') ? 'page' : undefined}
    >
      Packages
    </a>
    <ul class="pkgs" role="list">
      {
        packages.map((pkg) => {
          const open = pkg.slug === current;
          const guide = href(`${pkg.slug}/`);
          const to = (id: string) => (page === 'guide' ? `#${id}` : `${guide}#${id}`);
          return (
            <li class:list={['pkg', { 'pkg--open': open }]}>
              {pkg.status === 'live' ? (
                <a
                  class="pkg__card"
                  href={guide}
                  aria-current={open && page === 'guide' ? 'page' : undefined}
                  style={`view-transition-name: plate-${pkg.slug}`}
                >
                  <PackagePlate pkg={pkg} />
                </a>
              ) : (
                <span
                  class="pkg__card"
                  aria-disabled="true"
                  title={`${pkg.name} is in development`}
                  style={`view-transition-name: plate-${pkg.slug}`}
                >
                  <PackagePlate pkg={pkg} />
                </span>
              )}

              {open && (
                <div class:list={['tree', `tree--${pkg.slug}`]} style={`view-transition-name: tree-${pkg.slug}`}>
                  <ul class="tree__groups" role="list">
                    {sections.map((g) => (
                      <li class="grp" data-group={g.id}>
                        <div class="grp__row">
                          {g.children.length > 0 ? (
                            <button
                              class="grp__toggle"
                              type="button"
                              aria-expanded="false"
                              aria-controls={`grp-${g.id}`}
                              aria-label={`${g.label} sections`}
                            >
                              <svg viewBox="0 0 10 10" aria-hidden="true">
                                <path d="M3 1.5 7 5 3 8.5" />
                              </svg>
                            </button>
                          ) : (
                            <span class="grp__spacer" aria-hidden="true" />
                          )}
                          <a class="grp__link" href={to(g.id)} data-section={g.id}>
                            {g.label}
                          </a>
                        </div>
                        {g.children.length > 0 && (
                          <div class="grp__body" id={`grp-${g.id}`}>
                            <ul class="grp__kids" role="list">
                              {g.children.map((c) => (
                                <li>
                                  <a href={to(c.id)} data-section={c.id} data-parent={g.id}>
                                    {c.label}
                                  </a>
                                </li>
                              ))}
                            </ul>
                          </div>
                        )}
                      </li>
                    ))}
                  </ul>
                  <a class="tree__changelog" href={href(`${pkg.slug}/changelog/`)} aria-current={page === 'changelog' ? 'page' : undefined}>
                    <span>Changelog</span>
                    <span class="tree__changelog-ver">v{pkg.version}</span>
                  </a>
                </div>
              )}
            </li>
          );
        })
      }
    </ul>
  </nav>

  <nav class="side-group" aria-labelledby="side-blog-title">
    <a class="side-title" id="side-blog-title" href={postHref()} aria-current={here('blog') ? 'page' : undefined}>
      Blog
    </a>
    <ul class="posts" role="list">
      {
        posts.map((post) => {
          const open = section === 'blog' && post.slug === current;
          return (
            <li class:list={['post-item', { 'post-item--open': open }]}>
              <a class="post-link" href={postHref(post.slug)} aria-current={open ? 'page' : undefined}>
                <span class="post-link__title">{post.label}</span>
                <time class="post-link__date" datetime={post.date.toISOString().slice(0, 10)}>
                  {formatDate(post.date)}
                </time>
              </a>
              {open && (
                <ul class="side-links post-toc" role="list">
                  {post.sections.map((s) => (
                    <li>
                      <a href={`#${s.id}`} data-section={s.id}>
                        {s.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          );
        })
      }
    </ul>
  </nav>
  </div>

  <div class="side-foot">
    <a class="foot-link" href="https://assetstore.unity.com/publishers/66172" rel="noopener">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="m12.9288 4.2939 3.7997 2.1929c.1366.077.1415.2905 0 .3675l-4.515 2.6076a.4192.4192 0 0 1-.4246 0L7.274 6.8543c-.139-.0745-.1415-.293 0-.3675l3.7972-2.193V0L1.3758 5.5977V16.793l3.7177-2.1456v-4.3858c-.0025-.1565.1813-.2682.318-.1838l4.5148 2.6076a.4252.4252 0 0 1 .2136.3676v5.2127c.0025.1565-.1813.2682-.3179.1838l-3.7996-2.1929-3.7178 2.1457L12 24l9.6954-5.5977-3.7178-2.1457-3.7996 2.1929c-.1341.082-.3229-.0248-.3179-.1838V13.053c0-.1565.087-.2956.2136-.3676l4.5149-2.6076c.134-.082.3228.0224.3179.1838v4.3858l3.7177 2.1456V5.5977L12.9288 0Z"
        ></path>
      </svg>
      <span>Asset Store</span>
    </a>
    <a class="foot-link" href="https://discord.gg/e2wWESQXw2" rel="noopener">
      <svg viewBox="0 0 127.14 96.36" aria-hidden="true">
        <path
          d="M107.7,8.07A105.15,105.15,0,0,0,81.47,0a72.06,72.06,0,0,0-3.36,6.83A97.68,97.68,0,0,0,49,6.83,72.37,72.37,0,0,0,45.64,0,105.89,105.89,0,0,0,19.39,8.09C2.79,32.65-1.71,56.6.54,80.21h0A105.73,105.73,0,0,0,32.71,96.36,77.7,77.7,0,0,0,39.6,85.250a68.42,68.42,0,0,1-10.85-5.18c.91-.66,1.8-1.34,2.66-2a75.57,75.57,0,0,0,64.32,0c.87.71,1.76,1.39,2.66,2a68.68,68.68,0,0,1-10.87,5.19,77,77,0,0,0,6.89,11.1A105.25,105.25,0,0,0,126.6,80.22h0C129.24,52.84,122.09,29.11,107.7,8.07ZM42.45,65.69C36.18,65.69,31,60,31,53s5-12.74,11.43-12.74S54,46,53.89,53,48.84,65.69,42.45,65.69Zm42.24,0C78.410,65.690,73.25,60,73.25,53s5-12.74,11.44-12.74S96.23,46,96.12,53,91.08,65.69,84.69,65.69Z"
        ></path>
      </svg>
      <span>Discord</span>
    </a>
  </div>
</aside>
