---
interface Props {
  heroTitle: string;
  tagline: string;
}
const { heroTitle, tagline } = Astro.props;
---

<div class="hero">
  <div id="landing-text" class="sr-only"></div>
  <div id="landing" class="sr-only"></div>
  <h1>{heroTitle}</h1>
  <p>{tagline}</p>
</div>

<style>
  .hero h1 {
    margin: 0;
    max-width: 15ch;
    font: 800 clamp(42px, 6.4vw, 88px) / 0.95 var(--font-display);
    font-variation-settings: 'opsz' 96;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .hero p {
    margin: 24px 0 0;
    max-width: 46ch;
    font-size: clamp(17px, 1.6vw, 19px);
    line-height: 1.6;
    color: var(--muted);
  }
</style>
