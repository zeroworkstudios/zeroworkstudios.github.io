---
// A package's name plate in its own visual identity. Used in the sidebar and on the docs home.
// Skins live in src/styles/plates.css, one block per package slug.
import type { PackageEntry } from '../data/packages';

interface Props {
  pkg: PackageEntry;
  size?: 'sm' | 'lg';
}
const { pkg, size = 'sm' } = Astro.props;
---

<span class:list={['plate', `plate--${pkg.slug}`, `plate--${size}`, { 'plate--soon': pkg.status === 'soon' }]}>
  {
    pkg.slug === 'combo-counter' && (
      <>
        <span class="plate__tile" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M13.2 2 4.8 13.4h6l-1.4 8.6 8.8-11.8h-6.1z" fill="currentColor" />
          </svg>
        </span>
        <span class="plate__name">{pkg.name}</span>
        <span class="plate__ver">v{pkg.version}</span>
      </>
    )
  }
  {
    pkg.slug === 'scene-stats' && (
      <>
        <span class="plate__name">{pkg.name}</span>
        <span class="plate__readout" aria-hidden="true">
          <svg viewBox="0 0 36 14" class="plate__spark">
            <polyline points="0,9 4,8 8,10 12,6 16,7 20,4 24,6 28,5 32,3 36,4" />
          </svg>
          60<small>fps</small>
        </span>
        <span class="plate__soon">Soon</span>
      </>
    )
  }
  {
    pkg.slug === 'gasworks' && (
      <>
        <span class="plate__flame" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M12 2c1.2 3.4-.6 5.2-2.2 7.1C8.4 10.8 7 12.6 7 15a5 5 0 0 0 10 0c0-2.2-1-3.7-2-5 .1 1.6-.4 2.8-1.4 3.4.4-3.6-.6-7.9-1.6-11.4Z" />
          </svg>
        </span>
        <span class="plate__name">{pkg.name}</span>
        <span class="plate__soon">Soon</span>
      </>
    )
  }
</span>
